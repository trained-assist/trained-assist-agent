[Unit]
Description=Chrome browser for remote sessions (CDP :9224)
After=xvfb-browser.service wm-browser.service
Requires=xvfb-browser.service

[Service]
Type=simple
User=vova
Environment=DISPLAY=:99
Environment=HOME=/home/vova
ExecStartPre=/bin/sh -c "\
  rm -f \"/home/vova/chrome-profiles/browser-session/Default/Current Session\" \
         \"/home/vova/chrome-profiles/browser-session/Default/Last Session\" \
         \"/home/vova/chrome-profiles/browser-session/Default/Current Tabs\" \
         \"/home/vova/chrome-profiles/browser-session/Default/Last Tabs\"; \
  rm -rf \"/home/vova/chrome-profiles/browser-session/Default/Sessions\"; \
  sleep 2"
ExecStart=/usr/bin/google-chrome \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --user-data-dir=/home/vova/chrome-profiles/browser-session \
  --remote-debugging-port=9224 \
  --remote-debugging-address=127.0.0.1 \
  --window-size=1280,900 \
  --no-first-run \
  --no-default-browser-check \
  --disable-extensions \
  --disable-save-password-bubble \
  --disable-features=PasswordManager \
  --app=https://tilda.ru/login/
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

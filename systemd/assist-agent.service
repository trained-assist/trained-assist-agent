[Unit]
Description=Trained Assist Agent — Claude Code session runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vova
WorkingDirectory=/home/vova/trained-assist-agent
ExecStartPre=/bin/sh -c 'fuser -k 8080/tcp 2>/dev/null; true'
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
EnvironmentFile=-/home/vova/secrets.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=AGENT_DATA_DIR=/home/vova/alesa-data
Environment=AGENT_PUBLIC_URL=https://136-65-7-197.sslip.io/agent
Environment=HH_PLATFORM_URL=https://platform.recruiter-assistant.ru
Environment=VM_NAME=gcp-main

[Install]
WantedBy=multi-user.target

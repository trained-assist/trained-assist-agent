[Unit]
Description=Trained Assist Agent — RU IP instance
After=network.target

[Service]
Type=simple
User=vova
WorkingDirectory=/home/vova/trained-assist-agent
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=8080
Environment=AGENT_DATA_DIR=/home/vova/alesa-data

# Non-GCP: load secrets from env vars instead of GCP Secret Manager
Environment=SECRETS_SOURCE=env

# Route Telegram API through GCP proxy (Hostland blocks 149.154.x.x)
Environment=TELEGRAM_API_URL=https://136-65-7-197.sslip.io/tg-proxy

# Route Anthropic API through GCP proxy (Anthropic blocks Russian IPs)
Environment=ANTHROPIC_BASE_URL=https://136-65-7-197.sslip.io/anthropic-proxy

# === FILL IN THESE SECRETS ===
# Environment=TELEGRAM_BOT_TOKEN=...
# Environment=ANTHROPIC_API_KEY=...
# Environment=AGENT_SECRET=...
# Environment=DEEPGRAM_API_KEY=...
# Environment=BOT_SECRET=...

# Playwright display for headless Chrome
# Xvfb is started by playwright --headless, no need for DISPLAY

[Install]
WantedBy=multi-user.target

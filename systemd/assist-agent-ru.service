[Unit]
Description=Trained Assist Agent — RU IP instance
After=network.target
OnFailure=assist-agent-notify-failure.service

[Service]
Type=simple
User=vova
WorkingDirectory=/home/vova/trained-assist-agent
ExecStartPre=/bin/bash -c 'pids=$(lsof -ti tcp:8080 2>/dev/null); [ -n "$pids" ] && { echo "[pre-start] killing PIDs on :8080: $pids"; kill -9 $pids 2>/dev/null; sleep 1; }; true'
ExecStart=/usr/bin/node src/server.js
KillMode=mixed
Restart=always
RestartSec=2
StartLimitIntervalSec=300
StartLimitBurst=10
# Shutdown is instant (no drain) — this is only a backstop before SIGKILL.
TimeoutStopSec=15

Environment=NODE_ENV=production
Environment=MEDIA_GATEWAY_URL=https://trained-assist-tg-bot.skillset-apply.workers.dev
Environment=PORT=8080
Environment=AGENT_DATA_DIR=/home/vova/agent-data
# Canonical storage roots — set explicitly so a restart/HOME change can never
# silently relocate them (identity ≠ location). See src/data-paths.js.
Environment=USERS_DIR=/home/vova/users
Environment=AGENT_TOKENS_DIR=/home/vova/agent-tokens
Environment=VM_NAME=ru-vm

# Non-GCP: load secrets from env vars instead of GCP Secret Manager
Environment=SECRETS_SOURCE=env

# Public URL used in /connect/* links sent to users via Telegram
Environment=AGENT_PUBLIC_URL=https://platform.recruiter-assistant.ru

# Route Telegram API through GCP proxy (Hostland blocks 149.154.x.x)
Environment=TELEGRAM_API_URL=https://136-65-7-197.sslip.io/tg-proxy

# Route Anthropic API through GCP proxy (Anthropic blocks Russian IPs)
Environment=ANTHROPIC_BASE_URL=https://136-65-7-197.sslip.io/anthropic-proxy
Environment=ANTHROPIC_MODEL=claude-opus-5-5

# Claude Code is installed natively under ~/.local/bin on this box (the root-owned
# /usr/bin/claude from npm can't self-update without sudo). Put ~/.local/bin first
# so every `claude` spawn (runner.js, server.js, refresh scripts) uses the current CLI.
Environment=PATH=/home/vova/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Secrets loaded from /home/vova/secrets.env (not in git — set manually on the VM)
# Format: KEY=value lines (no quotes, no export)
EnvironmentFile=-/home/vova/secrets.env

# Playwright display for headless Chrome
# Xvfb is started by playwright --headless, no need for DISPLAY

[Install]
WantedBy=multi-user.target

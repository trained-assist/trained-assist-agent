{
  "version": 1,
  "providerId": "engineering",
  "actions": [
    {
      "name": "engineering_prepare_task",
      "inputSchema": {
        "type": "object",
        "required": ["repo_path", "task"],
        "properties": {
          "repo_path": { "type": "string" },
          "task": { "type": "string" },
          "prefer_index": { "type": "boolean" },
          "max_results": { "type": "number" }
        }
      },
      "allowedTriggers": ["user", "cron", "system"],
      "effect": "read",
      "requiresApproval": false,
      "retrySafety": "read_only"
    }
  ]
}

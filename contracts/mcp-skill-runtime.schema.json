{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trained-assist:mcp-skill-runtime:v1",
  "title": "Resolved generation snapshot / SessionMcpPlan / RunBinding v1 (PR1 contracts; no production mount)",
  "type": "object",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trigger": { "enum": ["user", "cron", "durable_task", "webhook", "system"] },
    "origin": { "enum": ["web", "mcp", "telegram", "api", "cron-service", "durable"] },
    "serverDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object" }
      }
    },
    "coreServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcpServerId", "command", "args"],
      "properties": {
        "mcpServerId": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object" }
      }
    },
    "hostBinding": {
      "description": "Authority carried into a run. Every field is host-side; model arguments/_meta never populate it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["engineRunId", "rootTaskId", "profileId", "trigger", "origin"],
      "properties": {
        "engineRunId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rootTaskId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "attemptId": { "type": ["string", "null"] },
        "nativeSessionId": { "type": ["string", "null"] },
        "profileId": { "$ref": "#/$defs/id" },
        "projectId": { "type": ["string", "null"] },
        "trigger": { "$ref": "#/$defs/trigger" },
        "origin": { "$ref": "#/$defs/origin" },
        "channel": { "type": ["string", "null"] },
        "resourceBindingVersion": { "type": ["string", "null"] },
        "repositoryBindingId": { "type": ["string", "null"] },
        "workspaceBindingId": { "type": ["string", "null"] },
        "brokerEndpoint": { "type": ["string", "null"] },
        "brokerCapability": { "type": ["string", "null"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "snapshotSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "mcpServerId", "repository", "revision", "manifestVersion",
        "artifactDir", "entrypoint", "manifest", "artifactDigest", "approvedManifest", "enabled",
        "profiles", "artifactStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "providerId": { "type": "string", "minLength": 1 },
        "mcpServerId": { "type": "string", "minLength": 1 },
        "repository": { "type": "string" },
        "revision": { "type": "string" },
        "manifestVersion": { "enum": [1, 2] },
        "artifactDir": { "type": "string" },
        "entrypoint": { "type": "string" },
        "manifest": { "type": "string" },
        "artifactDigest": { "type": "string" },
        "approvedManifest": { "type": "object" },
        "enabled": { "type": "boolean" },
        "profiles": { "type": "array", "items": { "type": "string" } },
        "artifactStatus": { "type": "string", "minLength": 1 }
      }
    },
    "generationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generationId", "configDigest", "coreCatalogDigest", "coreRevision",
        "deploymentPolicyDigest", "reservedServerIds", "adapter", "core", "sources", "diagnostics"],
      "properties": {
        "version": { "const": 1 },
        "generationId": { "type": "string", "minLength": 1 },
        "configDigest": { "$ref": "#/$defs/digest" },
        "coreCatalogDigest": { "$ref": "#/$defs/digest" },
        "coreRevision": { "type": "string" },
        "deploymentPolicyDigest": { "$ref": "#/$defs/digest" },
        "reservedServerIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "entry"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "entry": { "type": "string", "minLength": 1 }
          }
        },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["servers", "providerIds", "actionNames"],
          "properties": {
            "servers": { "type": "array", "items": { "$ref": "#/$defs/coreServer" } },
            "providerIds": { "type": "array", "items": { "type": "string" } },
            "actionNames": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/snapshotSource" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "runBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "engineRunId", "rootTaskId", "profileId", "trigger", "origin",
        "generationId", "snapshotDigest", "snapshotPath", "providerId", "mcpServerId",
        "sourceRevision", "artifactDigest"],
      "properties": {
        "version": { "const": 1 },
        "engineRunId": { "type": "string", "minLength": 1 },
        "rootTaskId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": ["string", "null"] },
        "nativeSessionId": { "type": ["string", "null"] },
        "profileId": { "$ref": "#/$defs/id" },
        "projectId": { "type": ["string", "null"] },
        "trigger": { "$ref": "#/$defs/trigger" },
        "origin": { "$ref": "#/$defs/origin" },
        "channel": { "type": ["string", "null"] },
        "generationId": { "type": "string", "minLength": 1 },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "snapshotPath": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "mcpServerId": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "artifactDigest": { "type": "string", "minLength": 1 },
        "resourceBindingVersion": { "type": ["string", "null"] },
        "repositoryBindingId": { "type": ["string", "null"] },
        "workspaceBindingId": { "type": ["string", "null"] },
        "brokerEndpoint": { "type": ["string", "null"] },
        "brokerCapability": { "type": ["string", "null"] }
      }
    },
    "sessionMcpPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "planId", "generationId", "configDigest", "coreCatalogDigest",
        "coreRevision", "snapshotDigest", "snapshot", "hostBinding", "servers", "mcpServers", "diagnostics"],
      "properties": {
        "version": { "const": 1 },
        "planId": { "type": "string", "minLength": 1 },
        "snapshot": { "$ref": "#/$defs/generationSnapshot" },
        "generationId": { "type": "string", "minLength": 1 },
        "configDigest": { "$ref": "#/$defs/digest" },
        "coreCatalogDigest": { "$ref": "#/$defs/digest" },
        "coreRevision": { "type": "string" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "hostBinding": { "$ref": "#/$defs/hostBinding" },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mcpServerId", "kind"],
            "properties": {
              "mcpServerId": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["core", "external"] },
              "providerId": { "type": "string", "minLength": 1 },
              "sourceId": { "type": "string", "minLength": 1 },
              "sourceRevision": { "type": "string" },
              "artifactDigest": { "type": "string" }
            }
          }
        },
        "mcpServers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/serverDescriptor" }
        },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    }
  }
}
